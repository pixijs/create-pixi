{
  "name": "create-pixi.js",
  "version": "2.0.0",
  "homepage": "https://pixijs.io/create-pixi/",
  "bugs": "https://github.com/pixijs/create-pixi/issues",
  "license": "MIT",
  "author": "PixiJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixijs/create-pixi.git"
  },
  "funding": "https://opencollective.com/pixijs/contribute",
  "bin": {
    "cpa": "index.js",
    "create-pixi": "index.js",
    "create-pixi.js": "index.js"
  },
  "workspaces": [
    "templates",
    "docs"
  ],
  "files": [
    "index.js",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-templates.ts",
    "build:docs": "npm run --workspace docs build",
    "deploy": "npm run deploy --workspace docs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "play": "node scripts/playground.ts",
    "prepare": "husky",
    "release": "xs bump,git-push",
    "start": "node index.js",
    "start:docs": "npm run --workspace docs start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && node scripts/typecheck-templates.ts",
    "update:templates": "npx --yes npm-check-updates@23 --packageFile templates/package.json --target semver -u && npm install",
    "verify": "node scripts/verify-template.ts"
  },
  "dependencies": {
    "minimist": "^1.2.8",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@pixi/extension-scripts": "^4.0.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.19.2",
    "@types/prompts": "^2.4.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rollup-plugin-node-externals": "^9.0.1",
    "sucrase": "^3.35.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
